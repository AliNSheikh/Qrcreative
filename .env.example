# qrcreative Environment Variables

# Site URL Configuration (Canonical origin used for dynamic QR redirect URLs)
# In development / preview, the app dynamically uses window.location.origin if not set.
# You can override with your custom domain or Cloud Run preview URL.
VITE_SITE_URL=https://ais-dev-2q7d3wxym3x4xe64heqemj-152706417383.europe-west2.run.app
NEXT_PUBLIC_SITE_URL=https://ais-dev-2q7d3wxym3x4xe64heqemj-152706417383.europe-west2.run.app
APP_URL=https://ais-dev-2q7d3wxym3x4xe64heqemj-152706417383.europe-west2.run.app

# Supabase Configuration
# (Supported with both VITE_ and NEXT_PUBLIC_ prefixes)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Side Secret Key (Optional - for high-performance server redirect logging)
SUPABASE_SERVICE_ROLE_KEY=

# GEMINI_API_KEY: Standard platform variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"

